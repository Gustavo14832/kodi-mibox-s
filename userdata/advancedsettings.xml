<advancedsettings version="1.0">
  <!-- Otimizações exclusivas para Xiaomi TV Box S (3rd Gen) - Amlogic S905X5M / Mali-G310 V2 -->

  <!-- Sincronia rígida de áudio para Amlogic MediaCodec (impede drift/delay acumulado) -->
  <audio>
    <maxpassthroughoffsyncduration>80</maxpassthroughoffsyncduration>
  </audio>

  <!-- Auto-limpeza de cache de pacotes (evita acumular lixo na memória interna eMMC) -->
  <packagecache>
    <maxage>1</maxage>
  </packagecache>

  <!-- Aproveitamento da memória flash eMMC 5.2 de 32 GB para capas e miniaturas em alta fidelidade -->
  <fanartres>1080</fanartres>
  <imageres>720</imageres>

  <!-- Otimizações de rede e estabilidade de socket para evitar erro 410 e quedas de CDN -->
  <network>
    <curlclienttimeout>30</curlclienttimeout>
    <curllowspeedtime>20</curllowspeedtime>
    <curlretries>3</curlretries>
    <disablehttp2>true</disablehttp2>
  </network>

  <!-- Filtro de debanding por hardware para suavização de streams e IPTV compactado -->
  <video>
    <deband>true</deband>
  </video>

  <!-- Troca instantânea de canal ao vivo (PVR / IPTV) -->
  <pvr>
    <numericchannelswitchtimeout>200</numericchannelswitchtimeout>
  </pvr>
</advancedsettings>
