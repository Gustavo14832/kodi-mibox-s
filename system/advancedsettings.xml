<advancedsettings version="1.0">
  <!-- Otimizações exclusivas para Xiaomi TV Box S (3rd Gen) - Amlogic S905X5M / Mali-G310 V2 -->

  <!-- Sincronia rígida de áudio para Amlogic MediaCodec (impede drift/delay acumulado) -->
  <audio>
    <maxpassthroughoffsyncduration>80</maxpassthroughoffsyncduration>
  </audio>

  <!-- Limite enxuto do cache de instaladores ZIP/pacotes na memória interna eMMC -->
  <packagefoldersize>20</packagefoldersize>

  <!-- Aproveitamento da memória flash eMMC 5.2 de 32 GB para capas e miniaturas em alta fidelidade -->
  <fanartres>1080</fanartres>
  <imageres>720</imageres>

  <!-- Otimizações de rede e estabilidade de socket para evitar erros transitórios e quedas de CDN -->
  <network>
    <curlclienttimeout>10</curlclienttimeout>
    <curllowspeedtime>10</curllowspeedtime>
    <curlretries>2</curlretries>
    <curlkeepaliveinterval>15</curlkeepaliveinterval>
    <disablehttp2>true</disablehttp2>
    <disableipv6>true</disableipv6>
  </network>

  <!-- Redesenho inteligente e regiões sujas: reduz carga de CPU/GPU quando a interface está parada -->
  <gui>
    <algorithmdirtyregions>3</algorithmdirtyregions>
    <smartredraw>true</smartredraw>
  </gui>

  <!-- Troca instantânea de canal ao vivo (PVR / IPTV) -->
  <pvr>
    <numericchannelswitchtimeout>200</numericchannelswitchtimeout>
  </pvr>
</advancedsettings>
